{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pdf-tw-localize/domain-pack.schema.json",
  "title": "pdf-tw-localize data-only domain pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack_id",
    "version",
    "schema_version",
    "public_core_compatibility",
    "contents",
    "pack_digest",
    "provenance",
    "scope",
    "load_policy"
  ],
  "properties": {
    "schema": {"const": "pdf-tw-localize/domain-pack/v1"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "schema_version": {"const": "1.0.0"},
    "pack_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "public_core_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum_exclusive"],
      "properties": {
        "minimum": {"type": "string"},
        "maximum_exclusive": {"type": "string"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "domain", "purpose"],
      "properties": {
        "locale": {"const": "zh-TW"},
        "domain": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "created_at", "source_basis", "confidentiality"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "source_basis": {"type": "string", "minLength": 1},
        "confidentiality": {"type": "string", "minLength": 1}
      }
    },
    "load_policy": {
      "const": {
        "mode": "explicit_path_only",
        "auto_discovery": false,
        "require_expected_identity": true,
        "data_only": true
      }
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "media_type", "role", "schema", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:).+$"},
          "media_type": {"enum": ["application/json", "application/yaml", "text/csv"]},
          "role": {"enum": ["glossary", "protected_names", "english_allowlist_policy", "regression_index", "domain_policy"]},
          "schema": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    }
  }
}
